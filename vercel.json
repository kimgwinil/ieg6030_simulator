{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ],
  "routes": [
    {
      "src": "/terminal_audit.html",
      "dest": "/terminal_audit.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
